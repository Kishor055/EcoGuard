# 🔐 Sensitive Files, API Keys, Credentials & Links
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
.env*

# API keys & key-related files/directories (case-insensitive patterns)
*api_key*
*API_KEY*
*ApiKey*
*apikey*
*APIKEY*
*OPENAI_API_KEY*
*GEMINI_API_KEY*
*WAQI_TOKEN*
*OWM_API_KEY*

# Private folders & files
private/
*private*
*PRIVATE*
*Private*

# General secret/credential configurations
*secret*
*SECRET*
*Secret*
*credential*
*CREDENTIAL*
*credentials*
config.ts
config.js
secret.ts
secret.js
secrets.ts
secrets.js
credentials.json
*.pem
*.key
*.pfx
*.cer
*.crt
*.der
*.p12


